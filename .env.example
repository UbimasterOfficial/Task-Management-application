# Backend application settings
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-host> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/cloudtask?retryWrites=true&w=majority

# Optional fallback when the local network blocks MongoDB SRV DNS queries.
# Copy the seed hosts and replica-set name from your Atlas connection details.
MONGODB_SEED_HOSTS=
MONGODB_REPLICA_SET=

# Comma-separated frontend origins allowed during local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
